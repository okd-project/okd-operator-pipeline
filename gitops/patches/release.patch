From e1076dae3f1117d986f1d879257591ed2e5540c8 Mon Sep 17 00:00:00 2001
From: Vadzim Dziadziulia <vadzim.dziadziulia@keemail.me>
Date: Thu, 22 Oct 2026 19:09:57 +0200
Subject: [PATCH] OKDify

---
 containers/argo-rollouts/Dockerfile        | 4 ++--
 containers/argocd-agent/Dockerfile         | 2 +-
 containers/argocd-image-updater/Dockerfile | 4 ++--
 containers/argocd/Dockerfile               | 8 ++++----
 containers/argocd/ui/.npmrc                | 3 ++-
 containers/console-plugin/Dockerfile       | 2 +-
 containers/dex/Dockerfile                  | 2 +-
 containers/gitops-operator/Dockerfile      | 3 +--
 containers/gitops-promoter/Dockerfile      | 4 ++--
 containers/gitops/Dockerfile               | 2 +-
 containers/must-gather/Dockerfile          | 3 ++-
 11 files changed, 19 insertions(+), 18 deletions(-)

diff --git a/containers/argo-rollouts/Dockerfile b/containers/argo-rollouts/Dockerfile
index 5068157..7634f92 100644
--- a/containers/argo-rollouts/Dockerfile
+++ b/containers/argo-rollouts/Dockerfile
@@ -18,7 +18,7 @@
 # Argo Rollouts Openshift Routes Plugin Build stage which performs the actual build of Argo Rollouts binaries
 ####################################################################################################
 
-FROM registry.redhat.io/rhel9/go-toolset:1.26 as rollouts-plugin-trafficrouter-openshift-build
+FROM registry.access.redhat.com/ubi9/go-toolset:1.26 as rollouts-plugin-trafficrouter-openshift-build
 USER root
 
 COPY sources/rollouts-plugin-trafficrouter-openshift/ /go/src/github.com/argoproj/rollouts-plugin-trafficrouter-openshift
@@ -35,7 +35,7 @@ RUN CGO_ENABLED=1 GOEXPERIMENT=strictfipsruntime go build -v -tags strictfipsrun
 # Argo Rollouts Build stage which performs the actual build of Argo Rollouts binaries
 ####################################################################################################
 
-FROM registry.redhat.io/rhel9/go-toolset:1.26 AS argo-rollouts-build
+FROM registry.access.redhat.com/ubi9/go-toolset:1.26 AS argo-rollouts-build
 USER root
 
 COPY sources/argo-rollouts/ /go/src/github.com/argoproj/argo-rollouts
diff --git a/containers/argocd-agent/Dockerfile b/containers/argocd-agent/Dockerfile
index 069ea23..3257da5 100644
--- a/containers/argocd-agent/Dockerfile
+++ b/containers/argocd-agent/Dockerfile
@@ -14,7 +14,7 @@
 #
 # ------------------------------------------------------------------------
 
-FROM registry.redhat.io/rhel9/go-toolset:1.26  AS builder
+FROM registry.access.redhat.com/ubi9/go-toolset:1.26  AS builder
 USER root
 
 ENV LANG=en_US.utf8
diff --git a/containers/argocd-image-updater/Dockerfile b/containers/argocd-image-updater/Dockerfile
index 5404f0c..b31bec0 100644
--- a/containers/argocd-image-updater/Dockerfile
+++ b/containers/argocd-image-updater/Dockerfile
@@ -15,7 +15,7 @@
 # ------------------------------------------------------------------------
 
 # Build the manager binary
-FROM registry.redhat.io/rhel9/go-toolset:1.26 AS builder
+FROM registry.access.redhat.com/ubi9/go-toolset:1.26 AS builder
 USER root
 
 ARG CI_ARGOCD_IMAGE_UPDATER_VERSION
@@ -37,7 +37,7 @@ RUN CGO_ENABLED=1 GOEXPERIMENT=strictfipsruntime \
 # in the UBI9 repos, so it is built from the pinned sources/tini submodule, the same way the argocd
 # and gitops-promoter images do it.
 ####################################################################################################
-FROM registry.redhat.io/rhel9/go-toolset:1.26 AS tini-build
+FROM registry.access.redhat.com/ubi9/go-toolset:1.26 AS tini-build
 USER root
 
 # Install cmake and build tini from the source in midstream
diff --git a/containers/argocd/Dockerfile b/containers/argocd/Dockerfile
index 4066568..fa816ea 100644
--- a/containers/argocd/Dockerfile
+++ b/containers/argocd/Dockerfile
@@ -39,9 +39,10 @@ COPY ["sources/argo-cd/ui/package.json", "containers/argocd/ui/pnpm-lock.yaml",
 COPY sources/argo-cd-ui-ref /usr/src/app/sources/argo-cd-ui-ref
 RUN node pin-argo-ui.js
 
-# packageManager pins pnpm@10.28.1; use the bootstrapped pnpm offline.
+# packageManager pins pnpm@10.28.1; use the bootstrapped pnpm. No Hermeto prefetch outside
+# Konflux, so install from the public npm registry (.npmrc), pinned by the frozen lockfile.
 RUN pnpm config set manage-package-manager-versions false
-RUN pnpm install --frozen-lockfile --offline --ignore-scripts
+RUN pnpm install --frozen-lockfile --ignore-scripts
 
 COPY ["sources/argo-cd/ui/", "."]
 # Restore the overlay lockfile (Hermeto-injected) and re-pin package.json after the submodule copy.
@@ -56,8 +57,7 @@ RUN HOST_ARCH=${TARGETARCH:-amd64} NODE_ENV='production' NODE_ONLINE_ENV='offlin
 ####################################################################################################
 # Argo CD Build stage which performs the actual build of Argo CD binaries
 ####################################################################################################
-# TODO: switch to registry.redhat.io once the image is available
-FROM registry.redhat.io/rhel9/go-toolset:1.26 as argocd-build
+FROM registry.access.redhat.com/ubi9/go-toolset:1.26 as argocd-build
 USER root
 
 COPY sources/argo-cd /go/src/github.com/argoproj/argo-cd
diff --git a/containers/argocd/ui/.npmrc b/containers/argocd/ui/.npmrc
index 5576b46..534f69a 100644
--- a/containers/argocd/ui/.npmrc
+++ b/containers/argocd/ui/.npmrc
@@ -1 +1,2 @@
-# Placeholder; Hermeto inject-files overwrites this during prefetch.
+# OKD build: no Hermeto prefetch, pnpm installs from the public registry.
+registry=https://registry.npmjs.org/
diff --git a/containers/console-plugin/Dockerfile b/containers/console-plugin/Dockerfile
index 81219eb..4d1fd41 100644
--- a/containers/console-plugin/Dockerfile
+++ b/containers/console-plugin/Dockerfile
@@ -31,7 +31,7 @@ RUN pnpm config set manage-package-manager-versions false
 WORKDIR /workspace/gitops-console-plugin
 
 COPY ["sources/gitops-console-plugin/package.json", "sources/gitops-console-plugin/pnpm-lock.yaml", "sources/gitops-console-plugin/.npmrc", "./"]
-RUN pnpm install --frozen-lockfile --offline
+RUN pnpm install --frozen-lockfile
 
 COPY ["sources/gitops-console-plugin/", "."]
 
diff --git a/containers/dex/Dockerfile b/containers/dex/Dockerfile
index 1cf5126..4ebc402 100644
--- a/containers/dex/Dockerfile
+++ b/containers/dex/Dockerfile
@@ -15,7 +15,7 @@
 # ------------------------------------------------------------------------
 
 # --- start build stage #1
-FROM registry.redhat.io/rhel9/go-toolset:1.26 as builder
+FROM registry.access.redhat.com/ubi9/go-toolset:1.26 as builder
 USER root
 
 COPY sources/dex /app/dex
diff --git a/containers/gitops-operator/Dockerfile b/containers/gitops-operator/Dockerfile
index 861aff9..7b2b9c0 100644
--- a/containers/gitops-operator/Dockerfile
+++ b/containers/gitops-operator/Dockerfile
@@ -14,8 +14,7 @@
 #
 # --
 
-# TODO: switch to registry.redhat.io once the image is available
-FROM registry.redhat.io/rhel9/go-toolset:1.26  AS builder
+FROM registry.access.redhat.com/ubi9/go-toolset:1.26  AS builder
 USER root
 
 # Copy source code
diff --git a/containers/gitops-promoter/Dockerfile b/containers/gitops-promoter/Dockerfile
index 2257ef0..fb9b4fe 100644
--- a/containers/gitops-promoter/Dockerfile
+++ b/containers/gitops-promoter/Dockerfile
@@ -46,7 +46,7 @@ RUN mkdir -p ../web/static && cp -r dist/* ../web/static
 #################################################################################################
 # GitOps Promoter Binary Build Stage
 #################################################################################################
-FROM registry.redhat.io/rhel9/go-toolset:1.26 AS promoter-build
+FROM registry.access.redhat.com/ubi9/go-toolset:1.26 AS promoter-build
 
 ARG TARGETOS
 ARG TARGETARCH
@@ -77,7 +77,7 @@ RUN CGO_ENABLED=1 GOEXPERIMENT=strictfipsruntime GOOS=${TARGETOS:-linux} GOARCH=
 #################################################################################################
 # Build tini binary
 #################################################################################################
-FROM registry.redhat.io/rhel9/go-toolset:1.26 AS tini-build
+FROM registry.access.redhat.com/ubi9/go-toolset:1.26 AS tini-build
 USER root
 
 # Install cmake and build tini from the source in midstream
diff --git a/containers/gitops/Dockerfile b/containers/gitops/Dockerfile
index 33feac8..0a0e4c9 100644
--- a/containers/gitops/Dockerfile
+++ b/containers/gitops/Dockerfile
@@ -1,5 +1,5 @@
 # Build Stage
-FROM  registry.redhat.io/rhel9/go-toolset:1.26 AS builder
+FROM  registry.access.redhat.com/ubi9/go-toolset:1.26 AS builder
 USER root
 
 COPY sources/gitops-backend /workspace
diff --git a/containers/must-gather/Dockerfile b/containers/must-gather/Dockerfile
index 196fdb8..4e616c8 100644
--- a/containers/must-gather/Dockerfile
+++ b/containers/must-gather/Dockerfile
@@ -13,7 +13,8 @@
 # limitations under the License.
 #
 # ------------------------------------------------------------------------
-FROM registry.redhat.io/openshift4/ose-must-gather-rhel9:v4.16.0
+# The OKD build passes --from <must-gather of the OKD release payload>.
+FROM quay.io/openshift/origin-must-gather:latest
 
 LABEL \
     name="openshift-gitops-1/must-gather-rhel9" \
-- 
2.54.0 (Apple Git-157)

