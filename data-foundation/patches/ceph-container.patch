From 0aceecebd914b0a70777c06676128c284be387f5 Mon Sep 17 00:00:00 2001
From: Owen Howard <owen@ziax.com>
Date: Thu, 24 Sep 2026 10:37:41 +0100
Subject: [PATCH] OKDify

---
 Dockerfile        | 20 +++++++++++---------
 ceph.repo         | 23 +++++++++++++++++++++++
 packages-ceph.txt |  2 --
 3 files changed, 34 insertions(+), 11 deletions(-)
 create mode 100644 ceph.repo

diff --git a/Dockerfile b/Dockerfile
index 5a9bd2e..69036be 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,12 +1,12 @@
 # CEPH DAEMON BASE IMAGE
 
-FROM registry.redhat.io/ubi10/ubi-minimal:latest
+FROM quay.io/centos/centos:stream10-minimal
 
 ENV I_AM_IN_A_CONTAINER 1
 ENV DOWNSTREAM_VERSION="9.2.0"
 
 # Who is the maintainer ?
-LABEL maintainer="Guillaume Abrioux <gabrioux@redhat.com>"
+LABEL maintainer="OKD Community <maintainers@okd.io>"
 
 # Is a ceph container ?
 LABEL ceph="True"
@@ -50,10 +50,12 @@ COPY ./licenses /licenses
 # Install ceph and dependencies, and clean up
 #======================================================
 
-RUN rm -f /etc/yum.repos.d/ubi.repo
+COPY ./ceph.repo /etc/yum.repos.d/ceph.repo
+# Enable the CRB repo for CentOS Stream 10. This is in /etc/yum.repos.d/centos.repo. Only replace the [crb] section.
+RUN sed -i '/^\[crb\]/,/^$/ s/enabled=0/enabled=1/' /etc/yum.repos.d/centos.repo
 
 # Editing /etc/redhat-storage-server release file
-RUN echo "Red Hat Ceph Storage Server 9 (Container)" > /etc/redhat-storage-release
+RUN echo "OKD Ceph Storage Server 9 (Container)" > /etc/redhat-storage-release
 
 EXPOSE 6789 6800 6801 6802 6803 6804 6805 80 5000
 
@@ -63,11 +65,11 @@ LABEL version="9"
 # Build specific labels
 LABEL com.redhat.component="rhceph-container"
 LABEL name=rhceph/rhceph-9-rhel10
-LABEL description="Red Hat Ceph Storage 9.2"
-LABEL summary="Provides the latest Red Hat Ceph Storage 9.2 on RHEL 10 in a fully featured and supported base image."
-LABEL io.k8s.display-name="Red Hat Ceph Storage 9.2 on RHEL 10"
-LABEL io.openshift.tags="rhceph ceph"
-LABEL io.k8s.description="Red Hat Ceph Storage 9.2"
+LABEL description="OKD Ceph Storage 9.2"
+LABEL summary="Provides the latest OKD Ceph Storage 9.2 on CentOS Stream 10 in a fully featured and supported base image."
+LABEL io.k8s.display-name="OKD Ceph Storage 9.2 on CentOS Stream 10"
+LABEL io.openshift.tags="okd ceph"
+LABEL io.k8s.description="OKD Ceph Storage 9.2"
 
 COPY packages-*.txt .
 
diff --git a/ceph.repo b/ceph.repo
new file mode 100644
index 0000000..656cce1
--- /dev/null
+++ b/ceph.repo
@@ -0,0 +1,23 @@
+[centos-nfs-ganesha-7]
+name=CentOS-$stream - NFS-Ganesha 7
+metalink=https://mirrors.centos.org/metalink?repo=centos-storage-sig-nfsganesha-7-10-stream&arch=$basearch
+gpgcheck=0
+enabled=1
+skip_if_unavailable=False
+
+[epel]
+name=Extra Packages for Enterprise Linux $releasever - $basearch
+metalink=https://mirrors.fedoraproject.org/metalink?repo=epel-$releasever&arch=$basearch&infra=$infra&content=$contentdir
+enabled=1
+gpgcheck=0
+skip_if_unavailable=False
+
+[okd-ceph-9-tools-for-centos-10-$basearch-rpms]
+name=okd-ceph-9-tools-for-centos-10-rpms
+baseurl=https://download.copr.fedorainfracloud.org/results/owenh/ceph/epel-10-$basearch/
+type=rpm-md
+skip_if_unavailable=False
+gpgcheck=0
+repo_gpgcheck=0
+enabled=1
+enabled_metadata=1
diff --git a/packages-ceph.txt b/packages-ceph.txt
index 98714fd..44c7b74 100644
--- a/packages-ceph.txt
+++ b/packages-ceph.txt
@@ -16,7 +16,6 @@ ceph-radosgw
 ceph-volume
 cephfs-mirror
 cephfs-top
-ganesha_monitoring
 libradosstriper1
 nfs-ganesha
 nfs-ganesha-ceph
@@ -26,4 +25,3 @@ nfs-ganesha-rgw
 nfs-ganesha-utils
 nfs-ganesha-vfs
 rbd-mirror
-python3-saml
-- 
2.55.0

